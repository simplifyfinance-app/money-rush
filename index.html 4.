<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="theme-color" content="#0f172a">

<title>Money Rush | Simplify Finance</title>

<style>
* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
  background: #f4f7fb;
  color: #172033;
}

.page {
  width: 100%;
  max-width: 520px;
  margin: 0 auto;
  padding: 18px 14px 30px;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.logo {
  font-size: 25px;
  font-weight: 800;
}

.subtitle {
  color: #64748b;
  font-size: 14px;
  margin-top: 3px;
}

.sound {
  border: 1px solid #d7deea;
  background: white;
  border-radius: 12px;
  padding: 11px;
  font-size: 15px;
  cursor: pointer;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-bottom: 10px;
}

.stat {
  background: white;
  border: 1px solid #dfe5ee;
  border-radius: 14px;
  padding: 8px;
  text-align: center;
}

.label {
  color: #64748b;
  font-size: 11px;
  font-weight: 700;
}

.value {
  font-size: 20px;
  font-weight: 800;
  margin-top: 2px;
}

#arena {
  height: 440px;
  background:
    linear-gradient(#dff4ff 0%, #eef9ff 62%, #e9eef4 62%, #d7dde5 100%);
  border: 1px solid #d6dee8;
  border-radius: 20px;
  overflow: hidden;
  position: relative;
  touch-action: manipulation;
}

.road-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 8px;
  height: 150px;
  opacity: .55;
  background: repeating-linear-gradient(
    to bottom,
    white 0,
    white 24px,
    transparent 24px,
    transparent 48px
  );
}

#player {
  position: absolute;
  bottom: 15px;
  left: calc(50% - 26px);
  width: 52px;
  text-align: center;
  font-size: 42px;
  z-index: 5;
  transition: left .08s ease-out;
  user-select: none;
}

.drop {
  position: absolute;
  top: -48px;
  width: 46px;
  height: 46px;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32px;
  user-select: none;
  will-change: transform;
}

.overlay {
  position: absolute;
  inset: 0;
  background: rgba(248,250,252,.96);
  z-index: 20;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 28px;
  text-align: center;
}

.hidden {
  display: none;
}

.bigemoji {
  font-size: 58px;
  margin-bottom: 8px;
}

h1 {
  margin: 5px 0;
  font-size: 27px;
}

.instructions {
  color: #64748b;
  line-height: 1.5;
  font-size: 15px;
}

.primary {
  border: 0;
  background: #2563eb;
  color: white;
  padding: 15px 27px;
  border-radius: 14px;
  font-weight: 800;
  font-size: 17px;
  cursor: pointer;
  min-width: 160px;
  margin-top: 10px;
}

.controls {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 11px;
}

.control {
  min-height: 60px;
  border: 1px solid #d7deea;
  border-radius: 15px;
  background: white;
  font-size: 17px;
  font-weight: 800;
  color: #1e293b;
  cursor: pointer;
}

.control:active {
  background: #e8eef7;
  transform: scale(.98);
}

#flash {
  position: absolute;
  top: 80px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 26px;
  font-weight: 900;
  z-index: 10;
  pointer-events: none;
}

.flashAnimation {
  animation: pop .55s ease-out forwards;
}

@keyframes pop {
  0% {
    opacity: 0;
    transform: scale(.7);
  }
  25% {
    opacity: 1;
    transform: scale(1.2);
  }
  100% {
    opacity: 0;
    transform: translateY(-30px);
  }
}

.final-score {
  font-size: 42px;
  font-weight: 900;
  margin: 10px 0;
}

.brand {
  text-align: center;
  color: #94a3b8;
  font-size: 12px;
  margin-top: 15px;
}

.tip {
  text-align: center;
  color: #64748b;
  font-size: 12px;
  margin-top: 8px;
}

@media (max-width: 400px) {
  .page {
    padding: 12px 10px 25px;
  }

  #arena {
    height: 410px;
  }

  .logo {
    font-size: 22px;
  }
}
</style>
</head>

<body>

<div class="page">

  <div class="header">
    <div>
      <div class="logo">💰 Money Rush</div>
      <div class="subtitle">Catch the money. Dodge the bills.</div>
    </div>

    <button id="soundBtn" class="sound">🔊</button>
  </div>

  <div class="stats">

    <div class="stat">
      <div class="label">SCORE</div>
      <div id="score" class="value">$0</div>
    </div>

    <div class="stat">
      <div class="label">TIME</div>
      <div id="time" class="value">60</div>
    </div>

    <div class="stat">
      <div class="label">BEST</div>
      <div id="best" class="value">$0</div>
    </div>

  </div>

  <div id="arena">

    <div class="road-line"></div>

    <div id="player">🚕</div>

    <div id="flash"></div>

    <div id="intro" class="overlay">

      <div>
        <div class="bigemoji">🚕💵</div>

        <h1>Got 60 seconds?</h1>

        <p class="instructions">
          Catch 💵 💰 💎 🪙 to earn money.<br>
          Avoid 🧾 and 💸.<br><br>
          Things get faster as the clock runs down!
        </p>

        <button id="startBtn" class="primary">
          START GAME
        </button>

      </div>

    </div>

    <div id="end" class="overlay hidden">

      <div>

        <div id="endEmoji" class="bigemoji">🏆</div>

        <h1 id="endTitle">
          Money Master!
        </h1>

        <div id="finalScore" class="final-score">
          $0
        </div>

        <p id="endMessage" class="instructions">
          Nice run!
        </p>

        <button id="againBtn" class="primary">
          PLAY AGAIN
        </button>

      </div>

    </div>

  </div>

  <div class="controls">

    <button id="leftBtn" class="control">
      ◀ MOVE
    </button>

    <button id="rightBtn" class="control">
      MOVE ▶
    </button>

  </div>

  <div class="tip">
    You can also tap the left or right side of the game.
  </div>

  <div class="brand">
    A little ride-time fun from <strong>Simplify Finance</strong>
  </div>

</div>

<script>

const arena = document.getElementById("arena");
const player = document.getElementById("player");

const scoreDisplay = document.getElementById("score");
const timeDisplay = document.getElementById("time");
const bestDisplay = document.getElementById("best");

const intro = document.getElementById("intro");
const endScreen = document.getElementById("end");

const flash = document.getElementById("flash");

let score = 0;
let timeLeft = 60;
let running = false;

let playerX = 0.5;

let objects = [];

let animationFrame;
let timer;

let lastFrame = 0;
let lastSpawn = 0;

let soundEnabled = true;

let bestScore =
  Number(localStorage.getItem("moneyRushBest") || 0);

bestDisplay.textContent = "$" + bestScore.toLocaleString();


const objectTypes = [

  { emoji:"💵", value:100, weight:32 },

  { emoji:"💰", value:150, weight:24 },

  { emoji:"🪙", value:50, weight:20 },

  { emoji:"💎", value:300, weight:8 },

  { emoji:"🧾", value:-150, weight:10 },

  { emoji:"💸", value:-250, weight:6 }

];


function chooseObject(){

  let random = Math.random() * 100;

  let total = 0;

  for(const item of objectTypes){

    total += item.weight;

    if(random < total){
      return item;
    }

  }

  return objectTypes[0];

}


function formatMoney(value){

  if(value < 0){
    return "-$" + Math.abs(value).toLocaleString();
  }

  return "$" + value.toLocaleString();

}


function updateStats(){

  scoreDisplay.textContent =
    formatMoney(score);

  timeDisplay.textContent =
    timeLeft;

  bestDisplay.textContent =
    formatMoney(bestScore);

}


function movePlayer(direction){

  if(!running) return;

  playerX += direction * 0.13;

  playerX =
    Math.max(0.07,
      Math.min(0.93, playerX));

  player.style.left =
    `calc(${playerX*100}% - 26px)`;

}


function createObject(){

  const type = chooseObject();

  const element =
    document.createElement("div");

  element.className = "drop";

  element.textContent =
    type.emoji;

  const x =
    0.06 + Math.random()*0.88;

  element.style.left =
    `calc(${x*100}% - 23px)`;

  arena.appendChild(element);

  objects.push({

    element,

    x,

    y:-50,

    value:type.value,

    speed:
      125 +
      Math.random()*55 +
      (60-timeLeft)*2.2

  });

}


function playSound(good){

  if(!soundEnabled) return;

  try {

    const AudioContext =
      window.AudioContext ||
      window.webkitAudioContext;

    if(!AudioContext) return;

    const context =
      new AudioContext();

    const oscillator =
      context.createOscillator();

    const gain =
      context.createGain();

    oscillator.connect(gain);

    gain.connect(
      context.destination
    );

    oscillator.frequency.value =
      good ? 650 : 180;

    gain.gain.value = 0.04;

    oscillator.start();

    oscillator.stop(
      context.currentTime + 0.07
    );

  } catch(e){}

}


function collect(object){

  score += object.value;

  if(score < 0)
    score = 0;


  if(score > bestScore){

    bestScore = score;

    localStorage.setItem(
      "moneyRushBest",
      bestScore
    );

  }


  flash.textContent =
    (object.value > 0 ? "+" : "")
    + formatMoney(object.value);


  flash.classList.remove(
    "flashAnimation"
  );

  void flash.offsetWidth;

  flash.classList.add(
    "flashAnimation"
  );


  playSound(
    object.value > 0
  );


  object.element.remove();

  objects =
    objects.filter(
      o => o !== object
    );


  updateStats();

}


function gameLoop(timestamp){

  if(!running) return;


  const delta =
    Math.min(
      0.032,
      (timestamp-lastFrame)/1000 || 0
    );


  lastFrame = timestamp;


  const spawnRate =
    Math.max(
      320,
      850-(60-timeLeft)*8
    );


  if(timestamp-lastSpawn > spawnRate){

    createObject();

    lastSpawn = timestamp;

  }


  const arenaHeight =
    arena.clientHeight;


  for(const object of [...objects]){

    object.y +=
      object.speed * delta;


    object.element.style.transform =
      `translateY(${object.y}px)`;


    const playerY =
      arenaHeight - 78;


    if(
      object.y + 40 > playerY &&
      object.y < playerY + 55 &&
      Math.abs(
        object.x-playerX
      ) < 0.11
    ){

      collect(object);

      continue;

    }


    if(object.y > arenaHeight+30){

      object.element.remove();

      objects =
        objects.filter(
          o => o !== object
        );

    }

  }


  animationFrame =
    requestAnimationFrame(
      gameLoop
    );

}


function clearGame(){

  objects.forEach(
    o => o.element.remove()
  );

  objects = [];


  clearInterval(timer);

  cancelAnimationFrame(
    animationFrame
  );

}


function startGame(){

  clearGame();


  score = 0;

  timeLeft = 60;

  playerX = 0.5;


  player.style.left =
    "calc(50% - 26px)";


  intro.classList.add(
    "hidden"
  );


  endScreen.classList.add(
    "hidden"
  );


  running = true;


  lastFrame =
    performance.now();


  lastSpawn = 0;


  updateStats();


  timer =
    setInterval(()=>{

      timeLeft--;

      updateStats();

      if(timeLeft <= 0){

        finishGame();

      }

    },1000);


  animationFrame =
    requestAnimationFrame(
      gameLoop
    );

}


function finishGame(){

  if(!running) return;


  running = false;


  clearGame();


  if(score > bestScore){

    bestScore = score;

    localStorage.setItem(
      "moneyRushBest",
      bestScore
    );

  }


  document.getElementById(
    "finalScore"
  ).textContent =
    formatMoney(score);


  let title =
    "Nice Run!";

  let emoji =
    "👏";

  let message =
    "Try again and beat your score!";


  if(score >= 5000){

    title =
      "Money Master!";

    emoji =
      "🏆";

    message =
      "That was seriously fast!";

  }

  else if(score >= 3000){

    title =
      "Cash Collector!";

    emoji =
      "💰";

    message =
      "Can you break $5,000?";

  }

  else if(score >= 1500){

    title =
      "Smart Saver!";

    emoji =
      "😎";

    message =
      "Nice! Go again for a bigger score.";

  }


  document.getElementById(
    "endTitle"
  ).textContent = title;


  document.getElementById(
    "endEmoji"
  ).textContent = emoji;


  document.getElementById(
    "endMessage"
  ).textContent = message;


  endScreen.classList.remove(
    "hidden"
  );


  updateStats();

}


document.getElementById(
  "startBtn"
).addEventListener(
  "click",
  startGame
);


document.getElementById(
  "againBtn"
).addEventListener(
  "click",
  startGame
);


document.getElementById(
  "leftBtn"
).addEventListener(
  "click",
  ()=>movePlayer(-1)
);


document.getElementById(
  "rightBtn"
).addEventListener(
  "click",
  ()=>movePlayer(1)
);


arena.addEventListener(
  "pointerdown",
  event=>{

    if(!running) return;


    const bounds =
      arena.getBoundingClientRect();


    if(
      event.clientX <
      bounds.left +
      bounds.width/2
    ){

      movePlayer(-1);

    }

    else {

      movePlayer(1);

    }

  }
);


document.getElementById(
  "soundBtn"
).addEventListener(
  "click",
  event=>{

    soundEnabled =
      !soundEnabled;


    event.currentTarget.textContent =
      soundEnabled
      ? "🔊"
      : "🔇";

  }
);


document.addEventListener(
  "keydown",
  event=>{

    if(event.key === "ArrowLeft")
      movePlayer(-1);

    if(event.key === "ArrowRight")
      movePlayer(1);

  }
);


updateStats();

</script>

</body>
</html>
